{
  "name": "@vinpassport/passport",
  "version": "0.0.0",
  "description": "VINPassport \u2014 a Digital Circularity Vehicle Passport (Reg. (EU) 2026/1738) on Midnight, built on @odatano/nightgate",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/VINPassport/VINPassport"
  },
  "engines": {
    "node": ">=22"
  },
  "comment": "Compact has no Windows binary: run `npm run compile` in WSL2, macOS or Linux. Tests run anywhere. @odatano/* versions are pinned EXACTLY on purpose - see docs/DECISIONS.md D10.",
  "dependencies": {
    "@odatano/dpp-sdk": "0.2.0",
    "@odatano/nightgate-tx": "0.4.0"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@noble/hashes": "^1.8.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "vitest run && node --test \"test/app/*.test.mjs\" && node test/sdk-assumptions.mjs",
    "test:contract": "vitest run",
    "test:watch": "vitest",
    "test:sdk": "node test/sdk-assumptions.mjs",
    "compile": "compact compile contracts/vinpassport/src/vinpassport.compact contracts/vinpassport/src/managed/vinpassport",
    "test:app": "node --test \"test/app/*.test.mjs\"",
    "demo:export": "node scripts/export-demo-state.mjs",
    "serve:scan": "npx serve app/scan",
    "deploy:preprod": "node scripts/deploy-preprod.mjs",
    "app": "node scripts/app-server.mjs",
    "intake": "node scripts/intake.mjs"
  }
}
