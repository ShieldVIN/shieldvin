// ShieldVIN — Digital Circularity Vehicle Passport
// Regulation (EU) 2026/1738, Article 46
//
// SPDX-License-Identifier: Apache-2.0
//
// A vehicle passport is not one number. This contract holds a COMMITMENT per
// (vehicle, field): the write-off category, the accident count, the number of
// keepers, the service and inspection record, the odometer. No field value
// ever reaches the ledger — only a commitment to it, and proofs about it.
//
// EACH FIELD CARRIES ITS OWN INTEGRITY RULE, fixed when the field is created
// and unchangeable afterwards. The rule is stored on the ledger rather than
// passed in per call, so a caller cannot choose the flattering rule at the
// moment they need it, and recreating a field to change it is refused.
//
// TWO DIRECTIONS EXIST because a rule that could only ever point one way would
// not be a rule — `initialiseField` would not need the argument, and nothing
// would be fixed at creation. Every field in the current panel only ever
// rises: mileage, accidents, keepers, services, write-off category. A field
// that may only fall is supported so that adding one later is a data change
// rather than a contract change.
//
// SCOPE. This is the VEHICLE's record. An electric car's battery is a separate
// regime with its own passport; the panel carries a reference to that passport
// and does not restate its claims.
//
// A PROVEN CLAIM IS RECORDED, the value behind it is not. A proof circuit that
// only asserted would leave nothing for a verifier to read afterwards: the
// transaction's success is the proof, but nothing would index it by vehicle.
// So a successful proof writes a Claim — which vehicle, which field, which
// direction, which bound — and never the value that satisfied it.

pragma language_version >= 0.20;

import CompactStandardLibrary;

// ---------------------------------------------------------------- integrity rules

// Which way a field is allowed to move over its lifetime.
export enum Rule {
  neverFalls,   // every field in the current panel
  neverRises    // reserved: no panel field uses this yet, by design
}

// ---------------------------------------------------------------- claims

// What a verifier reads after the fact.
//
// Everything here is already public: the bound and the field are call
// arguments, and the commitment is on the ledger. The VALUE that satisfied the
// claim is absent, which is the whole point.
//
// `commitment` is what the claim was proven against, so a claim cannot outlive
// the value it was made about. Record a new value for the field and the
// commitment moves on; a verifier comparing this against the current
// fieldCommitment sees the claim is stale rather than mistaking it for current.
//
// `slot` is carried so a verifier can find the current commitment by direct
// lookup. Deriving it needs persistentHash, which a plain browser page has no
// way to compute — see D19.
export struct Claim {
  slot: Bytes<32>,
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  commitment: Bytes<32>,
  bound: Uint<64>,
  atMost: Boolean
}

// ---------------------------------------------------------------- public ledger

// vinHash -> content root anchoring the canonical passport payload
export ledger passports: Map<Bytes<32>, Bytes<32>>;

// vinHash -> registering authority, so every claim is attributable
export ledger registrar: Map<Bytes<32>, Bytes<32>>;

// slot(vinHash, fieldKey) -> commitment to that field's current value
export ledger fieldCommitment: Map<Bytes<32>, Bytes<32>>;

// slot(vinHash, fieldKey) -> the integrity rule, written once at creation
export ledger fieldRule: Map<Bytes<32>, Rule>;

// claimKey -> the claim that was proven. Re-proving the same claim against the
// same value is idempotent: it writes the same key twice.
export ledger claims: Map<Bytes<32>, Claim>;

// How many field updates have been recorded across every vehicle
export ledger updateCount: Counter;

// ---------------------------------------------------------------- private state

// The value being written. Never disclosed.
witness newValue(): Uint<64>;

// The current value and its salt, so the caller can open the stored
// commitment in-circuit without revealing either.
witness previousValue(): Uint<64>;
witness previousSalt(): Bytes<32>;

// Fresh salt for the new commitment, so two vehicles holding the same value
// do not produce the same commitment.
witness newSalt(): Bytes<32>;

// ---------------------------------------------------------------- helpers

// Where a vehicle's field lives on the ledger. Domain-separated so a slot key
// can never collide with any other hash this contract stores.
circuit slotOf(vinHash: Bytes<32>, fieldKey: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "shieldvin:field:v1"), vinHash, fieldKey]
  );
}

// A claim's public name. Binds the direction, the slot, the bound AND the
// commitment, so proving "at most 0" and "at least 0" are different claims,
// and neither survives the value being updated.
circuit claimKey(
  tag: Bytes<32>,
  slot: Bytes<32>,
  bound: Uint<64>,
  commitment: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
    [tag, slot, bound as Bytes<32>, commitment]
  );
}

// ---------------------------------------------------------------- circuits

// Register a vehicle passport. The content root commits to the canonical
// 32-field payload held off-chain; only its hash is public.
export circuit registerPassport(
  vinHash: Bytes<32>,
  contentRoot: Bytes<32>,
  registrarId: Bytes<32>
): [] {
  assert(!passports.member(disclose(vinHash)), "passport already registered");
  passports.insert(disclose(vinHash), disclose(contentRoot));
  registrar.insert(disclose(vinHash), disclose(registrarId));
}

// Create a field and fix its integrity rule for good. The opening value is a
// witness, so the field exists on chain without its value being published.
export circuit initialiseField(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  rule: Rule
): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");

  const slot = slotOf(disclose(vinHash), disclose(fieldKey));
  assert(!fieldCommitment.member(slot), "field already initialised");

  const value = newValue();
  fieldCommitment.insert(slot, persistentCommit<Uint<64>>(value, newSalt()));
  fieldRule.insert(slot, disclose(rule));
  updateCount.increment(1);
}

// Write a new value for a field, proving in-circuit that the caller knows the
// current one and that the change respects the rule fixed at creation.
// Neither value is disclosed.
export circuit recordField(vinHash: Bytes<32>, fieldKey: Bytes<32>): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");

  const slot = slotOf(disclose(vinHash), disclose(fieldKey));
  assert(fieldCommitment.member(slot), "field not initialised");

  const prev = previousValue();
  const prevSalt = previousSalt();

  // The caller must genuinely know the current value: its commitment has to
  // reproduce what the ledger already holds.
  assert(
    persistentCommit<Uint<64>>(prev, prevSalt) == fieldCommitment.lookup(slot),
    "previous value does not open the stored commitment"
  );

  const current = newValue();
  const rule = fieldRule.lookup(slot);

  // Both guards are evaluated every time; each is vacuous under the other
  // rule. Written this way rather than as a branch so that the failure a
  // caller sees names which direction they violated.
  assert(rule != Rule.neverFalls || current >= prev, "value decreased");
  assert(rule != Rule.neverRises || current <= prev, "value increased");

  fieldCommitment.insert(slot, persistentCommit<Uint<64>>(current, newSalt()));
  updateCount.increment(1);
}

// Prove the hidden value is at or below a public bound.
// "Under 150 000 km." "Never had a reported accident" is this with bound 0.
export circuit proveFieldAtMost(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  bound: Uint<64>
): [] {
  const slot = slotOf(disclose(vinHash), disclose(fieldKey));
  assert(fieldCommitment.member(slot), "field not initialised");

  const value = previousValue();
  const salt = previousSalt();
  const commitment = fieldCommitment.lookup(slot);

  assert(
    persistentCommit<Uint<64>>(value, salt) == commitment,
    "value does not open the stored commitment"
  );

  assert(value <= disclose(bound), "value above the claimed bound");

  // Only reached when the claim holds: a failed proof aborts above and writes
  // nothing.
  claims.insert(
    claimKey(pad(32, "shieldvin:claim:atmost:v1"), slot, disclose(bound), commitment),
    Claim {
      slot: slot,
      vinHash: disclose(vinHash),
      fieldKey: disclose(fieldKey),
      commitment: commitment,
      bound: disclose(bound),
      atMost: true
    }
  );
}

// Prove the hidden value is at or above a public bound.
// The mirror of proveFieldAtMost: a floor rather than a ceiling.
export circuit proveFieldAtLeast(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  bound: Uint<64>
): [] {
  const slot = slotOf(disclose(vinHash), disclose(fieldKey));
  assert(fieldCommitment.member(slot), "field not initialised");

  const value = previousValue();
  const salt = previousSalt();
  const commitment = fieldCommitment.lookup(slot);

  assert(
    persistentCommit<Uint<64>>(value, salt) == commitment,
    "value does not open the stored commitment"
  );

  assert(value >= disclose(bound), "value below the claimed bound");

  claims.insert(
    claimKey(pad(32, "shieldvin:claim:atleast:v1"), slot, disclose(bound), commitment),
    Claim {
      slot: slot,
      vinHash: disclose(vinHash),
      fieldKey: disclose(fieldKey),
      commitment: commitment,
      bound: disclose(bound),
      atMost: false
    }
  );
}
